{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "folding": {
    "offSide": true
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:- )?[^#\\s].*:\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
